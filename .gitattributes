# Normalize line endings in the repository (LF) and use native ones on checkout
* text=auto

# Windows
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.varfile  text eol=crlf

# Linux
*.sh       text eol=lf

# Binaries
*.jar  binary
*.zip  binary
*.cup  binary
*.exe  binary
