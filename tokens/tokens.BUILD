# Tokens for the BUILD environment
# Format: KEY=value (literal value, Windows paths as-is). Empty value = not defined.
# No passwords here: they go in secrets\tokens.BUILD.secrets (not versioned).

# --- Installation ---
INSTALL_DIR=D:\calypso_v19\BUILD
INSTALLER_PATH=D:\calypso_v19\dowloads\calypso-installer-19.26.10.1-win64-rel.exe
# Paths separated by ';'
JDBC_DRIVER_FILES=D:\calypso_v19\dowloads\ojdbc8-23.26.3.0.0.jar

# --- .cup build ---
SOURCE_REPO_URL=git@github.com:WaiTangChi/Cal_v19_custom.git
# Temporary, until Artifactory is available
CUP_OUTPUT_DIR=D:\calypso_v19\cups
